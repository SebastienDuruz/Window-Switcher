<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:colorPicker="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.ColorPicker"
        xmlns:viewModels="clr-namespace:WindowSwitcher.ViewModels"
        Icon="/Assets/WS_logo.ico"
        mc:Ignorable="d"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        Topmost="True"
        x:Class="WindowSwitcher.Windows.SettingsWindow"
        SystemDecorations="Full"
        Title="Settings"
        x:DataType="viewModels:SettingsViewModel">
        <Grid Margin="8"
              ColumnDefinitions="Auto,Auto"
              RowDefinitions="Auto,Auto"
              ColumnSpacing="16"
              RowSpacing="8">
                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                        <CheckBox Content="Resize windows" IsChecked="{Binding ResizeWindows, Mode=TwoWay}" />
                        <CheckBox Content="Window decorations"
                                  IsVisible="{Binding ShowWindowDecorationsVisible}"
                                  IsChecked="{Binding ShowWindowDecorations, Mode=TwoWay}" />
                        <CheckBox Content="Fixed size" IsChecked="{Binding UseFixedWindowSize, Mode=TwoWay}" />
                        <StackPanel Name="FixedWidthStackPanel"
                                    IsVisible="{Binding UseFixedWindowSize}"
                                    Orientation="Horizontal"
                                    Spacing="6">
                                <TextBlock VerticalAlignment="Center">Width</TextBlock>
                                <NumericUpDown Width="130" Value="{Binding WindowWidth, Mode=TwoWay}" Minimum="10" Maximum="2000" Increment="1" />
                        </StackPanel>

                        <StackPanel Name="FixedHeightStackPanel"
                                    IsVisible="{Binding UseFixedWindowSize}"
                                    Orientation="Horizontal"
                                    Spacing="6">
                                <TextBlock VerticalAlignment="Center">Height</TextBlock>
                                <NumericUpDown Width="130" Value="{Binding WindowHeight, Mode=TwoWay}" Minimum="10" Maximum="2000" Increment="1" />
                        </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="8">
                        <CheckBox Content="Move windows" IsChecked="{Binding MoveWindows, Mode=TwoWay}" />
                        <CheckBox Content="Focus on hover" IsChecked="{Binding FocusOnHover, Mode=TwoWay}" />
                        <CheckBox Content="Start minimized" IsChecked="{Binding StartMinimized, Mode=TwoWay}" />
                        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                                <TextBlock VerticalAlignment="Center">Highlight color</TextBlock>
                                <colorPicker:ColorPicker Grid.Column="1"
                                                         Width="60"
                                                         Color="{Binding PreviewHighlightColor, Mode=TwoWay}"
                                                         IsAlphaVisible="False" />
                        </Grid>

                        

                        <StackPanel IsVisible="{Binding LinuxPipeWireSettingsVisible}" Orientation="Vertical" Spacing="4">
                                <TextBlock Text="Linux preview backend" />
                                <ComboBox Width="240"
                                          ItemsSource="{Binding LinuxPreviewBackendOptions}"
                                          SelectedItem="{Binding LinuxPreviewBackend, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel IsVisible="{Binding LinuxPipeWireSettingsVisible}" Orientation="Vertical" Spacing="0">
                                <TextBlock Text="{Binding LinuxPipeWireFps, StringFormat=PipeWire fps: {0}}" />
                                <Slider Width="240"
                                        Minimum="1"
                                        Maximum="60"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding LinuxPipeWireFps, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel IsVisible="{Binding LinuxPipeWireSettingsVisible}" Orientation="Vertical" Spacing="0">
                                <TextBlock Text="{Binding LinuxPipeWireReconnectDelayMs, StringFormat=PipeWire reconnect (ms): {0}}" />
                                <Slider Width="240"
                                        Minimum="100"
                                        Maximum="30000"
                                        TickFrequency="100"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding LinuxPipeWireReconnectDelayMs, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel IsVisible="{Binding LinuxPipeWireSettingsVisible}" Orientation="Vertical" Spacing="4">
                                <TextBlock Text="PipeWire node id (optional override)" />
                                <TextBox Width="240" Text="{Binding LinuxPipeWireNodeId, Mode=TwoWay}" />
                        </StackPanel>

                        <!-- Linux-only screenshot settings: keep last -->
                        <StackPanel IsVisible="{Binding LinuxScreenshotQualityVisible}" Orientation="Vertical" Spacing="0">
                                <TextBlock Text="{Binding ScreenshotQuality, StringFormat=Screenshot quality: {0}}" />
                                <Slider Width="240"
                                        Minimum="1"
                                        Maximum="100"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding ScreenshotQuality, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel IsVisible="{Binding LinuxScreenshotSettingsVisible}" Orientation="Vertical" Spacing="0">
                                <TextBlock Text="{Binding ScreenshotRefreshTimeoutMs, StringFormat=Screenshot refresh (ms): {0}}" />
                                <Slider Width="240"
                                        Minimum="100"
                                        Maximum="10000"
                                        TickFrequency="100"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding ScreenshotRefreshTimeoutMs, Mode=TwoWay}" />
                        </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding ApplyCommand}">Apply</Button>
                </StackPanel>
        </Grid>
</Window>
