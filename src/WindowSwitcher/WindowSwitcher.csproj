<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <ApplicationIcon>Assets/WS_logo.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.0.5" />
        <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.0.5" />
        <PackageReference Include="Avalonia.Desktop" Version="12.0.5" />
        <PackageReference Include="Avalonia.X11" Version="12.0.5" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.5" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.5" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
        <PackageReference
            Include="NSIS"
            Version="2.51.0"
            Condition="$([MSBuild]::IsOSPlatform('Windows'))"
        />
    </ItemGroup>

    <ItemGroup Condition="'$(EnableSentryTelemetry)' == 'true'">
        <PackageReference Include="Sentry" Version="6.6.0" />
    </ItemGroup>

    <ItemGroup Condition="'$(EnableSentryTelemetry)' != 'true'">
        <Compile Remove="Diagnostics\SentryAppTelemetry.cs" />
        <Compile Remove="Diagnostics\SentrySdkAdapter.cs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\WindowSwitcher.Lib\WindowSwitcher.Lib.csproj" />
    </ItemGroup>
    <ItemGroup>
        <AvaloniaResource Include="Assets\WS_logo.ico" />
        <AvaloniaResource Include="Assets\WS_logo.png" />
        <Content
            Include="Assets\WS_logo.ico"
            CopyToOutputDirectory="PreserveNewest"
            CopyToPublishDirectory="PreserveNewest"
        />
        <Content
            Include="Assets\WS_logo.png"
            CopyToOutputDirectory="PreserveNewest"
            CopyToPublishDirectory="PreserveNewest"
        />
    </ItemGroup>
    <ItemGroup>
        <Compile Update="Windows\FloatingWindow.axaml.cs">
            <DependentUpon>FloatingWindow.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Windows\MainWindow.axaml.cs">
            <DependentUpon>MainWindow.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Windows\KeybindsWindow.axaml.cs">
            <DependentUpon>KeybindsWindow.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Windows\FiltersWindow.axaml.cs">
            <DependentUpon>FiltersWindow.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Windows\RenameWindow.axaml.cs">
            <DependentUpon>RenameWindow.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
    </ItemGroup>
</Project>
