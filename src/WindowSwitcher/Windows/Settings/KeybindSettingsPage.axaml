<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:WindowSwitcher.ViewModels"
             x:Class="WindowSwitcher.Windows.Settings.KeybindSettingsPage"
             x:DataType="viewModels:KeybindSettingsViewModel">
    <UserControl.Resources>
        <!-- One table row: target name, its shortcuts, then "+" or the inline capture. -->
        <DataTemplate x:Key="KeybindTargetRowTemplate"
                      x:DataType="viewModels:KeybindTargetRowViewModel">
            <StackPanel>
                <Border Classes="settings-divider" />
                <Grid Margin="10,3,6,3"
                      MinHeight="30"
                      ColumnDefinitions="160,*"
                      ColumnSpacing="10">
                    <TextBlock VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding DisplayName}"
                               ToolTip.Tip="{Binding DisplayName}" />
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                        <ItemsControl ItemsSource="{Binding Shortcuts}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:KeybindShortcutOption">
                                    <Border Classes="keybind-chip">
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <TextBlock VerticalAlignment="Center"
                                                       FontWeight="Medium"
                                                       Text="{Binding Display}" />
                                            <Button Classes="keybind-chip-remove"
                                                    Content="✕"
                                                    ToolTip.Tip="Remove shortcut"
                                                    Command="{Binding $parent[ItemsControl].((viewModels:KeybindTargetRowViewModel)DataContext).RemoveShortcutCommand}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Classes="keybind-add"
                                Content="+"
                                ToolTip.Tip="Add shortcut"
                                IsVisible="{Binding !IsCapturing}"
                                Command="{Binding BeginCaptureCommand}" />

                        <StackPanel Orientation="Horizontal"
                                    Spacing="6"
                                    Margin="0,2"
                                    IsVisible="{Binding IsCapturing}">
                            <Border Classes="keybind-capture">
                                <TextBlock VerticalAlignment="Center" Text="{Binding CapturePreview}" />
                            </Border>
                            <Button Content="Save" Command="{Binding ConfirmCaptureCommand}" />
                            <Button Content="Cancel" Command="{Binding CancelCaptureCommand}" />
                        </StackPanel>
                    </WrapPanel>
                </Grid>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="settings-page-title" Margin="0" Text="Keybinds" />
            <Button Grid.Column="1"
                    VerticalAlignment="Center"
                    Content="Refresh client targets"
                    Command="{Binding RefreshTargetsCommand}" />
        </Grid>
        <TextBlock Classes="settings-group-intro"
                   Margin="0"
                   Text="Global shortcuts per target. Use + to add one, then press the keys." />

        <Border Padding="10"
                CornerRadius="6"
                BorderThickness="1"
                BorderBrush="{StaticResource ErrorTextBrush}"
                IsVisible="{Binding ShowGlobalKeyboardSetupBanner}">
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding GlobalKeyboardSetupTitle}"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding GlobalKeyboardSetupMessage}"
                           TextWrapping="Wrap" />
                <TextBlock Text="Recommended command"
                           IsVisible="{Binding ShowGlobalKeyboardSetupCommand}"
                           Foreground="{StaticResource MutedTextBrush}" />
                <TextBox Text="{Binding GlobalKeyboardSetupCommand}"
                         IsVisible="{Binding ShowGlobalKeyboardSetupCommand}"
                         IsReadOnly="True"
                         HorizontalAlignment="Stretch" />
                <TextBlock Text="{Binding GlobalKeyboardSetupGuidance}"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <TextBlock Classes="keybind-status"
                   Classes.success="{Binding IsStatusSuccess}"
                   Classes.error="{Binding IsStatusError}"
                   IsVisible="{Binding HasStatusMessage}"
                   Text="{Binding StatusMessage}"
                   TextWrapping="Wrap" />

        <Border Classes="settings-card">
            <StackPanel>
                <Grid Margin="10,4,6,4" ColumnDefinitions="160,*" ColumnSpacing="10">
                    <TextBlock Classes="settings-description" Text="TARGET" />
                    <TextBlock Grid.Column="1" Classes="settings-description" Text="SHORTCUTS" />
                </Grid>

                <Border Classes="settings-divider" />
                <TextBlock Classes="keybind-group" Text="Actions" />
                <ItemsControl ItemsSource="{Binding ActionRows}"
                              ItemTemplate="{StaticResource KeybindTargetRowTemplate}" />

                <Border Classes="settings-divider" />
                <TextBlock Classes="keybind-group" Text="Client windows" />
                <ItemsControl ItemsSource="{Binding ClientRows}"
                              ItemTemplate="{StaticResource KeybindTargetRowTemplate}" />
                <StackPanel IsVisible="{Binding !HasClientRows}">
                    <Border Classes="settings-divider" />
                    <TextBlock Margin="10,6"
                               Classes="settings-description"
                               Text="No client window yet: windows tracked by the filters appear here." />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
