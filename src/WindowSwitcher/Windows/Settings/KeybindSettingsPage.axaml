<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:WindowSwitcher.ViewModels"
             x:Class="WindowSwitcher.Windows.Settings.KeybindSettingsPage"
             x:DataType="viewModels:KeybindSettingsViewModel">
    <Grid ColumnDefinitions="*,*"
          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
          ColumnSpacing="10"
          RowSpacing="6">
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                   Classes="settings-page-title"
                   Margin="0"
                   Text="Keybinds" />
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                   Classes="settings-group-intro"
                   Margin="0"
                   Text="Configure global keybinds per target." />

        <Border Grid.Row="2"
                Grid.ColumnSpan="2"
                Padding="10"
                CornerRadius="6"
                BorderThickness="1"
                BorderBrush="{StaticResource ErrorTextBrush}"
                IsVisible="{Binding ShowGlobalKeyboardSetupBanner}">
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding GlobalKeyboardSetupTitle}"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding GlobalKeyboardSetupMessage}"
                           TextWrapping="Wrap" />
                <TextBlock Text="Recommended command"
                           IsVisible="{Binding ShowGlobalKeyboardSetupCommand}"
                           Foreground="{StaticResource MutedTextBrush}" />
                <TextBox Text="{Binding GlobalKeyboardSetupCommand}"
                         IsVisible="{Binding ShowGlobalKeyboardSetupCommand}"
                         IsReadOnly="True"
                         HorizontalAlignment="Stretch" />
                <TextBlock Text="{Binding GlobalKeyboardSetupGuidance}"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Grid.Column="0" Spacing="8">
            <TextBlock Classes="settings-group-title" Margin="0" Text="Actions" />
            <ListBox ItemsSource="{Binding ActionTargets}"
                     SelectedItem="{Binding SelectedActionTarget, Mode=TwoWay}"
                     MaxHeight="110">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Classes="settings-group-title" Margin="0" Text="Client windows" />
            <ListBox ItemsSource="{Binding ClientTargets}"
                     SelectedItem="{Binding SelectedClientTarget, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Button Content="Refresh client targets"
                    Command="{Binding RefreshTargetsCommand}"
                    HorizontalAlignment="Right" />
        </StackPanel>

        <StackPanel Grid.Row="3" Grid.Column="1" Spacing="8">
            <TextBlock Classes="settings-group-title" Margin="0" Text="Shortcuts for selected target" />
            <ListBox ItemsSource="{Binding Shortcuts}"
                     SelectedItem="{Binding SelectedShortcut, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Display}" FontWeight="Medium" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Add shortcut" Command="{Binding BeginCaptureCommand}" />
                <Button Content="Remove selected" Command="{Binding RemoveShortcutCommand}" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Center"
                    IsVisible="{Binding IsCapturing}">
            <TextBlock Text="Capture mode:" VerticalAlignment="Center" />
            <TextBlock Text="{Binding CapturePreview}" VerticalAlignment="Center" />
            <Button Content="Save" Command="{Binding ConfirmCaptureCommand}" />
            <Button Content="Cancel" Command="{Binding CancelCaptureCommand}" />
        </StackPanel>

        <TextBlock Grid.Row="5" Grid.ColumnSpan="2"
                   Text="{Binding StatusMessage}"
                   Foreground="{StaticResource ErrorTextBrush}"
                   TextWrapping="Wrap" />
    </Grid>
</UserControl>
