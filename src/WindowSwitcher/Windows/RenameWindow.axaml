<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:WindowSwitcher.ViewModels"
        Icon="/Assets/WS_logo.ico"
        mc:Ignorable="d"
        CanResize="False"
        SizeToContent="WidthAndHeight"
        WindowDecorations="Full"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        Topmost="True"
        x:Class="WindowSwitcher.Windows.RenameWindow"
        Title="Rename window"
        x:DataType="viewModels:RenameViewModel">
        <StackPanel Orientation="Vertical"
                    Margin="10"
                    Spacing="8">
                <TextBlock Classes="window-section-title"
                           Text="Rename window" />
                <TextBlock Foreground="{StaticResource MutedTextBrush}"
                           Text="Choose the title shown by Window Switcher." />
                <TextBox Name="WindowTitleTextBox" Text="{Binding WindowTitle, Mode=TwoWay}"></TextBox>
                <TextBlock Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12"
                           IsVisible="{Binding HasOriginalTitle}">
                        <Run Text="Original title:" />
                        <Run FontWeight="SemiBold" Text="{Binding OriginalTitle}" />
                </TextBlock>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Button Content="Restore original"
                                IsVisible="{Binding HasOriginalTitle}"
                                Command="{Binding RestoreOriginalCommand}" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                <Button Command="{Binding CancelCommand}">Cancel</Button>
                                <Button Command="{Binding ConfirmCommand}">Rename</Button>
                        </StackPanel>
                </Grid>
        </StackPanel>
</Window>