<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:WindowSwitcher.ViewModels"
        xmlns:models="clr-namespace:WindowSwitcher.Lib.Models;assembly=WindowSwitcher.Lib"
        Icon="/Assets/WS_logo.ico"
        mc:Ignorable="d" CanResize="False"
        Width="300"
        SizeToContent="Height"
        x:Class="WindowSwitcher.Windows.MainWindow"
        ShowInTaskbar="True"
        CanMinimize="True"
        Topmost="True"
        Title="WindowSwitcher"
        ClosingBehavior="OwnerAndChildWindows"
        x:DataType="viewModels:WindowListViewModel">
    <DockPanel>
        <Menu DockPanel.Dock="Top" FontSize="12" Padding="0" Margin="0">
            <MenuItem Header="_Config" Padding="4">
                <MenuItem Header="_Filters" Click="OpenFiltersWindowClick" />
                <MenuItem Header="_Keybinds" Click="OpenKeybindsWindowClick" />
                <MenuItem Header="_Settings" Click="OpenSettingsWindowClick" />
            </MenuItem>
            <MenuItem Header="_File" Padding="4">
                <MenuItem Header="_Open data folder" Click="OpenDataFolderClick"></MenuItem>
                <MenuItem Header="_Clean config file" Click="ClearFloatingWindowSettings"></MenuItem>
                <MenuItem Header="_Generate new config file" Click="ResetUserSettings"></MenuItem>
            </MenuItem>
            <MenuItem Header="_Help" Padding="4">
                <MenuItem Header="_About" Click="OpenAppInfoWindowClick" />
            </MenuItem>
        </Menu>
        <StackPanel Orientation="Vertical" Margin="8" Spacing="0">
            <ListBox x:Name="WindowsListBox"
                     ItemsSource="{Binding WindowsConfigs}"
                     SelectedItem="{Binding SelectedWindow, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="Transparent"
                                HorizontalAlignment="Stretch">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Add to blacklist" Click="BlacklistMenuItemClick" Tag="{Binding WindowTitle}"></MenuItem>
                                    <MenuItem Header="Add to temp blacklist" Click="TempBlacklistMenuItemClick" Tag="{Binding WindowId}"></MenuItem>
                                    <MenuItem Header="Rename window" Click="RenameMenuItemClick" Tag="{Binding WindowId}"></MenuItem>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <TextBlock Text="{Binding ShortWindowTitle}" FontSize="14" />
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Height" Value="22" />
                        <Setter Property="FontSize" Value="14" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Name"
                                Value="{Binding WindowId, RelativeSource={RelativeSource AncestorType=models:WindowConfig}}" />
                        <Setter Property="Padding" Value="8, 2" />
                    </Style>
                </ListBox.Styles>
            </ListBox>
        </StackPanel>
    </DockPanel>
</Window>
