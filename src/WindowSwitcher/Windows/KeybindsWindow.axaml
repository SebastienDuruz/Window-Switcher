<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:WindowSwitcher.ViewModels"
        Icon="/Assets/WS_logo.ico"
        mc:Ignorable="d"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        Topmost="True"
        x:Class="WindowSwitcher.Windows.KeybindsWindow"
        Title="Keybinds"
        KeyDown="WindowKeyDown"
        x:DataType="viewModels:KeybindSettingsViewModel">
    <Grid Margin="10"
          ColumnDefinitions="2*,3*"
          RowDefinitions="Auto,Auto,*,Auto,Auto"
          ColumnSpacing="12"
          RowSpacing="10">
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                   Text="Configure global keybinds per target."
                   FontWeight="Normal" />

        <Border Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Padding="10"
                CornerRadius="6"
                BorderThickness="1"
                BorderBrush="{StaticResource ErrorTextBrush}"
                IsVisible="{Binding ShowGlobalKeyboardSetupBanner}">
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding GlobalKeyboardSetupTitle}"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding GlobalKeyboardSetupMessage}"
                           TextWrapping="Wrap" />
                <TextBlock Text="Recommended command"
                           IsVisible="{Binding ShowGlobalKeyboardSetupCommand}"
                           Foreground="{StaticResource MutedTextBrush}" />
                <TextBox Text="{Binding GlobalKeyboardSetupCommand}"
                         IsVisible="{Binding ShowGlobalKeyboardSetupCommand}"
                         IsReadOnly="True"
                         HorizontalAlignment="Stretch" />
                <TextBlock Text="{Binding GlobalKeyboardSetupGuidance}"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Grid.Column="0"
              RowDefinitions="Auto,Auto,Auto,*,Auto"
              RowSpacing="8">
            <TextBlock Grid.Row="0"
                       Text="Actions"
                       FontWeight="Normal" />

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding ActionTargets}"
                     SelectedItem="{Binding SelectedActionTarget, Mode=TwoWay}"
                     MaxHeight="110">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="2"
                       Text="Client windows"
                       FontWeight="Normal" />

            <ListBox Grid.Row="3"
                     ItemsSource="{Binding ClientTargets}"
                     SelectedItem="{Binding SelectedClientTarget, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Button Grid.Row="4"
                    Content="Refresh client targets"
                    Command="{Binding RefreshTargetsCommand}"
                    HorizontalAlignment="Right" />
        </Grid>

        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="8">
            <TextBlock Text="Shortcuts for selected target" FontWeight="Normal" />
            <ListBox ItemsSource="{Binding Shortcuts}"
                     SelectedItem="{Binding SelectedShortcut, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Display}" FontWeight="Medium" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Add shortcut" Command="{Binding BeginCaptureCommand}" />
                <Button Content="Remove selected" Command="{Binding RemoveShortcutCommand}" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Center"
                    IsVisible="{Binding IsCapturing}">
            <TextBlock Text="Capture mode:" FontWeight="Normal" VerticalAlignment="Center" />
            <TextBlock Text="{Binding CapturePreview}" VerticalAlignment="Center" />
            <Button Content="Save"
                    Command="{Binding ConfirmCaptureCommand}" />
            <Button Content="Cancel" Command="{Binding CancelCaptureCommand}" />
        </StackPanel>

        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                   Text="{Binding StatusMessage}"
                   Foreground="{StaticResource ErrorTextBrush}"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
