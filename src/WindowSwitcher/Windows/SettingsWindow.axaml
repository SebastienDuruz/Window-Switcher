<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:colorPicker="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.ColorPicker"
        xmlns:viewModels="clr-namespace:WindowSwitcher.ViewModels"
        Icon="/Assets/WS_logo.ico"
        mc:Ignorable="d"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        Topmost="True"
        x:Class="WindowSwitcher.Windows.SettingsWindow"
        SystemDecorations="Full"
        Title="Settings"
        x:DataType="viewModels:SettingsViewModel">
        <StackPanel Margin="10"
                    MinWidth="200"
                    Spacing="8"
                    Orientation="Vertical">
                <StackPanel Spacing="6">
                        <CheckBox Content="Move windows"
                                  IsChecked="{Binding MoveWindows, Mode=TwoWay}" />
                        <CheckBox Content="Focus on hover"
                                  IsChecked="{Binding FocusOnHover, Mode=TwoWay}" />
                        <CheckBox Content="Enable previews"
                                  IsChecked="{Binding EnablePreviews, Mode=TwoWay}" />
                        <CheckBox Content="Start minimized"
                                  IsChecked="{Binding StartMinimized, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Spacing="6">
                        <CheckBox Content="Resize windows"
                                  IsChecked="{Binding ResizeWindows, Mode=TwoWay}"
                                  IsEnabled="{Binding CanEditResizeWindows}" />
                        <CheckBox Content="Fixed size"
                                  IsChecked="{Binding UseFixedWindowSize, Mode=TwoWay}" />
                        <Grid IsEnabled="{Binding UseFixedWindowSize}"
                              Margin="18 0 0 0"
                              HorizontalAlignment="Stretch"
                              ColumnDefinitions="*,Auto"
                              RowDefinitions="Auto,Auto"
                              ColumnSpacing="8"
                              RowSpacing="6">
                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left"
                                           Text="Width" />
                                <NumericUpDown Grid.Row="0"
                                               Grid.Column="1"
                                               HorizontalAlignment="Right"
                                               Value="{Binding WindowWidth, Mode=TwoWay}"
                                               Minimum="10"
                                               Maximum="2000"
                                               Increment="1" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left"
                                           Text="Height" />
                                <NumericUpDown Grid.Row="1"
                                               Grid.Column="1"
                                               HorizontalAlignment="Right"
                                               Value="{Binding WindowHeight, Mode=TwoWay}"
                                               Minimum="10"
                                               Maximum="2000"
                                               Increment="1" />
                        </Grid>
                </StackPanel>

                <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="120,Auto"
                              ColumnSpacing="8">
                                <TextBlock Grid.Column="0"
                                           VerticalAlignment="Center"
                                           Text="Highlight color" />
                                <colorPicker:ColorPicker Grid.Column="1"
                                                         Width="60"
                                                         Color="{Binding PreviewHighlightColor, Mode=TwoWay}"
                                                         IsAlphaVisible="False" />
                        </Grid>
                </StackPanel>
                <Border Padding="10 0 0 0"
                        BorderBrush="{StaticResource SettingsSectionBorderBrush}"
                        BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0 8 0 0"
                                    Spacing="6">
                                <Button Command="{Binding ApplyCommand}">
                                        Apply
                                </Button>
                        </StackPanel>
                </Border>
        </StackPanel>
</Window>
