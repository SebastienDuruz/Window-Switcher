<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:settings="clr-namespace:WindowSwitcher.Windows.Settings"
        xmlns:viewModels="clr-namespace:WindowSwitcher.ViewModels"
        Icon="/Assets/WS_logo.ico"
        mc:Ignorable="d"
        Width="640"
        Height="460"
        CanResize="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        x:Class="WindowSwitcher.Windows.SettingsWindow"
        Classes="settings-window"
        Title="Settings"
        KeyDown="WindowKeyDown"
        x:DataType="viewModels:SettingsWindowViewModel">
    <Grid ColumnDefinitions="140,*">
        <Border Background="{StaticResource SettingsSidebarBrush}"
                BorderBrush="{StaticResource SettingsSectionBorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="4,6">
                <TextBlock DockPanel.Dock="Bottom"
                           Margin="8,6"
                           Classes="settings-description"
                           Text="Changes are saved automatically." />
                <ListBox Classes="settings-nav"
                         SelectedIndex="{Binding SelectedPageIndex, Mode=TwoWay}">
                    <ListBoxItem Content="General" />
                    <ListBoxItem Content="Previews" />
                    <ListBoxItem Content="Filters" />
                    <ListBoxItem Content="Keybinds" />
                    <ListBoxItem Content="About" />
                </ListBox>
            </DockPanel>
        </Border>

        <Carousel Grid.Column="1" SelectedIndex="{Binding SelectedPageIndex}">
            <ScrollViewer>
                <settings:GeneralSettingsPage Margin="14,10,14,14" />
            </ScrollViewer>
            <ScrollViewer>
                <settings:PreviewSettingsPage Margin="14,10,14,14" />
            </ScrollViewer>
            <ScrollViewer>
                <settings:FilterSettingsPage x:Name="FiltersPage" Margin="14,10,14,14" />
            </ScrollViewer>
            <ScrollViewer>
                <settings:KeybindSettingsPage x:Name="KeybindsPage" Margin="14,10,14,14" />
            </ScrollViewer>
            <ScrollViewer>
                <settings:AboutSettingsPage x:Name="AboutPage" Margin="14,10,14,14" />
            </ScrollViewer>
        </Carousel>
    </Grid>
</Window>
