<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <OutputType>Exe</OutputType>
        <!--
          xUnit1051 asks every awaited call to receive TestContext.Current.CancellationToken.
          It reports about 170 call sites and its code fix cannot run in batch, so the rule stays
          disabled until those calls are updated in a dedicated change.
        -->
        <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
        <PackageReference Include="xunit.v3" Version="3.2.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\WindowSwitcher\WindowSwitcher.csproj" />
        <ProjectReference Include="..\WindowSwitcher.Lib\WindowSwitcher.Lib.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(EnableSentryTelemetry)' != 'true'">
        <Compile Remove="AppExceptionTests.cs" />
        <Compile Remove="Diagnostics\SentryBreadcrumbSinkTests.cs" />
    </ItemGroup>
</Project>
