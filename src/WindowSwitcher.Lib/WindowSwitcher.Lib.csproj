<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <PublishAot>true</PublishAot>
        <PublishTrimmed>true</PublishTrimmed>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.0.5" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="Tmds.DBus" Version="0.94.2" />
    </ItemGroup>

    <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
        <PipeWireNativeSource>$(MSBuildProjectDirectory)/Data/Platform/WindowAccess/PreviewFrames/Pipewire/Native/window_switcher_pipewire.c</PipeWireNativeSource>
        <PipeWireNativeRuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">linux-x64</PipeWireNativeRuntimeIdentifier>
        <PipeWireNativeRuntimeIdentifier Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</PipeWireNativeRuntimeIdentifier>
        <PipeWireNativeIntermediateDirectory>$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/$(PipeWireNativeRuntimeIdentifier)/native</PipeWireNativeIntermediateDirectory>
        <PipeWireNativeOutput>$(PipeWireNativeIntermediateDirectory)/libwindowswitcher-pipewire.so</PipeWireNativeOutput>
        <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);GetPipeWireNativeBuildOutput</TargetsForTfmSpecificBuildOutput>
    </PropertyGroup>

    <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
        <None
            Include="$(PipeWireNativeOutput)"
            Link="libwindowswitcher-pipewire.so"
            CopyToOutputDirectory="PreserveNewest"
            CopyToPublishDirectory="PreserveNewest"
            Visible="false"
        />
    </ItemGroup>

    <Target
        Name="ValidateLinuxRuntimeIdentifier"
        BeforeTargets="PrepareForBuild"
        Condition="$([MSBuild]::IsOSPlatform('Linux'))"
    >
        <Error
            Condition="'$(PipeWireNativeRuntimeIdentifier)' != 'linux-x64'"
            Text="Unsupported Linux runtime '$(PipeWireNativeRuntimeIdentifier)'. Window Switcher supports linux-x64 only."
        />
    </Target>

    <Target
        Name="BuildPipeWireNative"
        BeforeTargets="PrepareForBuild"
        DependsOnTargets="ValidateLinuxRuntimeIdentifier"
        Inputs="$(PipeWireNativeSource)"
        Outputs="$(PipeWireNativeOutput)"
        Condition="$([MSBuild]::IsOSPlatform('Linux'))"
    >
        <MakeDir Directories="$(PipeWireNativeIntermediateDirectory)" />
        <Exec Command="cc -std=c17 -O2 -fPIC -fvisibility=hidden -Wall -Wextra -Werror -shared `pkg-config --cflags libpipewire-0.3` &quot;$(PipeWireNativeSource)&quot; -o &quot;$(PipeWireNativeOutput)&quot; `pkg-config --libs libpipewire-0.3` -pthread" />
        <Copy SourceFiles="$(PipeWireNativeOutput)" DestinationFolder="$(TargetDir)" />
    </Target>

    <Target
        Name="GetPipeWireNativeBuildOutput"
        DependsOnTargets="BuildPipeWireNative"
        Returns="@(BuildOutput)"
        Condition="$([MSBuild]::IsOSPlatform('Linux'))"
    >
        <ItemGroup>
            <BuildOutput Include="$(PipeWireNativeOutput)">
                <TargetPath>libwindowswitcher-pipewire.so</TargetPath>
            </BuildOutput>
        </ItemGroup>
    </Target>
</Project>
